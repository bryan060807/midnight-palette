# Copy to .env. Run npm install for PostgreSQL mode. Requires Node.js 24+.
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1.5
IMAGE_QUALITY=medium
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data
# Required for non-loopback HOST; use at least 16 characters. Never reuse your API key.
APP_PASSWORD=
# Limits provider attempts (including failures), not dollars. Full tutorial: 8 calls.
MAX_PROVIDER_CALLS_PER_DAY=40
# Explicit no-network developer test mode: AI_PROVIDER=mock
DIBBY_MAX_CONCURRENT=1
DIBBY_TIMEOUT_MS=45000
# Required for unauthenticated Dibby development. Loopback-only; never enable on a public bind.
DIBBY_DEV_MODE=false


# Optional private studio: separate AIBRY ID profiles, Fedora PostgreSQL sync.
# Leave local mode until DB access and the exact AIBRY ID client are provisioned.
MIDNIGHT_STORAGE=local
# Server-only credential. Alternatively read DATABASE_URL from a protected env file.
MIDNIGHT_DATABASE_URL=
# Defaults to the sibling Canvas Ritual .env on the existing Windows deployment.
MIDNIGHT_DATABASE_ENV_FILE=
# Optional installed-pg fallback: absolute path to the sibling package.json.
MIDNIGHT_PG_PACKAGE_FILE=
