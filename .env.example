# Copy to .env. No package installation required. Requires Node.js 24+.
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1.5
IMAGE_QUALITY=medium
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data
# Required for non-loopback HOST; use at least 16 characters. Never reuse your API key.
APP_PASSWORD=
# Limits provider attempts (including failures), not dollars. Full tutorial: 8 calls.
MAX_PROVIDER_CALLS_PER_DAY=40
# Explicit no-network developer test mode: AI_PROVIDER=mock

# Opt-in: publish ONLY bundled lessons through read-only /mcp. No private data.
DIBBY_PUBLIC_CATALOG=false
